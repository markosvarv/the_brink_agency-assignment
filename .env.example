# -----------------------------------------------------------------------------
# Payload CMS Configuration
# -----------------------------------------------------------------------------

# Secret key used to verify and encrypt Payload sessions and tokens (REQUIRED)
# Generate a secure string using: openssl rand -hex 32
PAYLOAD_SECRET=your_payload_secret_key_here

# SQLite Database connection string (defaults to file:./payload.db)
DATABASE_URI=file:./payload.db

# -----------------------------------------------------------------------------
# Optional Application Settings
# -----------------------------------------------------------------------------

# Public server URL for absolute links and metadata
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret key used to authorize the Daily Digest cron endpoint (/api/cron/daily-digest)
CRON_SECRET=your_cron_secret_key_here

# Recipient email address for daily contact inquiries digest (defaults to vacancy@example.com)
DAILY_DIGEST_EMAIL=vacancy@example.com

# Sender email address for automated confirmation and digest emails
SMTP_FROM="The Brink <noreply@thebrink.agency>"
