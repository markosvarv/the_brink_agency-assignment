{
  "name": "the-brink-agency-assignment",
  "version": "1.0.0",
  "description": "Payload CMS project with Next.js, TypeScript, and Tailwind CSS",
  "license": "MIT",
  "type": "module",
  "author": "Markos Varvagiannis <markosvarv@gmail.com> (https://github.com/markosvarv)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markosvarv/the_brink_agency-assignment.git"
  },
  "bugs": {
    "url": "https://github.com/markosvarv/the_brink_agency-assignment/issues"
  },
  "homepage": "https://github.com/markosvarv/the_brink_agency-assignment#readme",
  "scripts": {
    "build": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload generate:importmap && next build",
    "clean": "rm -rf .next",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/run-migrations.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/run-migrations.ts && cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.25.0",
    "@payloadcms/next": "3.25.0",
    "@payloadcms/richtext-lexical": "3.25.0",
    "@payloadcms/ui": "3.25.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.10.0",
    "next": "15.1.4",
    "payload": "3.25.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-config-next": "15.1.4",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
